# build output
src-tauri/target/
src-tauri/gen/

# this machine's project list and the app's own log (the app writes both; maestro.config.example.json shows the shape)
maestro.config.json
maestro.log
*.bak

# words that must never be committed: read by tools/leak-check.mjs, one pattern per line
.private-words

# the stamp a local commit check leaves
.claude/.validation-passed

# captures made while testing
shot*.png
.playwright-mcp/

# notes of one working session and its timings
.claude/SESSION.md
.claude/METRICS.md
